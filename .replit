modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.development]
API_PORT = "3000"
PUBLIC_BASE_URL = "https://c0122279-cf36-4f32-8acd-17050ab230c2-00-2f3brla7izimq.worf.replit.dev"
RPC_URL = "https://api.devnet.solana.com"
SOLANA_CLUSTER = "devnet"
VITE_RPC_URL = "https://api.devnet.solana.com"
