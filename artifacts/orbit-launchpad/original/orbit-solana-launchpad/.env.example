# DEVNET FIRST. MAINNET NEEDS VERIFIED INFRASTRUCTURE AND EXPLICIT CONFIG CHANGE.
SOLANA_CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
# Browser can use this RPC URL. Never expose private API key RPC_URL unless intended.
VITE_RPC_URL=https://api.devnet.solana.com
# Absolute public HTTPS site URL for persistent token metadata (NO localhost for live mint).
PUBLIC_BASE_URL=
# Optional: user-supplied platform ID (fee distributions depend on its on-chain settings).
VITE_RAYDIUM_PLATFORM_ID=
# API endpoint auth token is server side only. Required for migrated pool swaps.
JUPITER_API_KEY=
PORT=3000
# Optional data directory; default ./data
DATA_DIR=

# Verified Raydium LaunchLab program address on Solana Devnet.
RAYDIUM_PROGRAM_ID=DRay6fNdQ5J82H7xV6uq2aV3mNrUZ1J4PgSKsWgptcm6
